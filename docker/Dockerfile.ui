# The UI only talks to the API over HTTP, so it needs none of the ML stack.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN pip install streamlit pandas plotly matplotlib seaborn httpx numpy
COPY src/app.py src/api_client.py src/visualization.py ./src/
EXPOSE 8501
CMD ["streamlit", "run", "src/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
